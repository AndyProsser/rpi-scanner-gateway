[Unit]
Description=Scan pipeline watcher (OCR, compress, upload, email)
After=network-online.target smbd.service
Wants=network-online.target

[Service]
Type=simple
User=scanpipeline
WorkingDirectory=/opt/scan-pipeline
Environment=PYTHONPATH=/opt/scan-pipeline
ExecStart=/opt/scan-pipeline/venv/bin/python -m app.watcher
Restart=on-failure
RestartSec=10

# Modest hardening — the service only needs its own dirs and network out
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
