<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  LAN mDNS advertisement for the dashboard, independent of the Pi's own
  hostname and of Tailscale MagicDNS (see docs/SETUP.md step 8 for how
  this gets installed, and step 7 for the Tailscale alternative).
-->
<service-group>
  <name replace-wildcards="yes">Scanner Gateway on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>5000</port>
  </service>
</service-group>
